<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <FrameLayout
        android:id="@+id/contentArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavigation"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/tunerGroup"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/tunerDisplayContainer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp"
                app:layout_constraintBottom_toTopOf="@+id/modeSelectionContainer"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/noteText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/symbol_dash"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="100sp" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_listening"
                    android:textAllCaps="true"
                    android:textColor="?attr/colorOutline"
                    android:lines="2"
                    android:gravity="center"/>

                <view
                    android:id="@+id/tunerScale"
                    class="com.eduashi.strings.TunerScaleView"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginTop="32dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/modeSelectionContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:paddingHorizontal="24dp"
                app:layout_constraintBottom_toBottomOf="parent">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnModeChromatic"
                    style="@style/Widget.Strings.ModeButton.Selected"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:text="@string/mode_chromatic" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnModePresets"
                    style="@style/Widget.Strings.ModeButton.Unselected"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:text="@string/mode_presets" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/metronomeLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="24dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/bpmControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintBottom_toTopOf="@+id/metronomeButtonsContainer"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.6">

                <view
                    android:id="@+id/metronomeScale"
                    class="com.eduashi.strings.TunerScaleView"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMinus"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/symbol_minus"
                        android:textSize="32sp"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

                    <TextView
                        android:id="@+id/bpmText"
                        android:layout_width="160dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:text="@string/default_bpm"
                        android:textSize="80sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPlus"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/symbol_plus"
                        android:textSize="32sp"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />
                </LinearLayout>
            </LinearLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/metronomeButtonsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTap"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="152dp"
                    android:layout_margin="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/btn_tap"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/guideline_v50"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guideline_v50"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.5" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStartStop"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_margin="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/btn_start"
                    app:icon="@android:drawable/ic_media_play"
                    app:iconGravity="textStart"
                    app:layout_constraintBottom_toTopOf="@+id/btnTimeSignature"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/guideline_v50"
                    app:layout_constraintTop_toTopOf="parent"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTimeSignature"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_margin="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/default_time_signature"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/guideline_v50"
                    app:layout_constraintTop_toBottomOf="@+id/btnStartStop"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:id="@+id/generatorLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:id="@+id/tvGeneratorFreq"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/default_frequency"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="56sp" />

                <TextView
                    android:id="@+id/tvGeneratorNote"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="32dp"
                    android:alpha="0.7"
                    android:text="@string/default_note"
                    android:textSize="20sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderGenerator"
                    style="@style/Widget.App.FatSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:value="440.0"
                    android:valueFrom="20.0"
                    android:valueTo="5000.0" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutWaveform"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:paddingHorizontal="24dp"
                android:weightSum="3">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipWaveSine"
                    style="@style/Widget.Material3.Chip.Suggestion"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:checkable="true"
                    android:gravity="center"
                    android:text="@string/chipWaveSine"
                    android:textAlignment="center" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipWaveSquare"
                    style="@style/Widget.Material3.Chip.Suggestion"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:checkable="true"
                    android:gravity="center"
                    android:text="@string/chipWaveSquare"
                    android:textAlignment="center" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipWaveSaw"
                    style="@style/Widget.Material3.Chip.Suggestion"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checkable="true"
                    android:gravity="center"
                    android:text="@string/chipWaveSaw"
                    android:textAlignment="center" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:paddingHorizontal="24dp"
                android:weightSum="2">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:hint="@string/note_word">

                    <AutoCompleteTextView
                        android:id="@+id/autoCompleteNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:padding="16dp"
                        tools:ignore="LabelFor" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:hint="@string/octave_word">

                    <AutoCompleteTextView
                        android:id="@+id/autoCompleteOctave"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:padding="16dp"
                        tools:ignore="LabelFor" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGeneratorStart"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginBottom="32dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/btn_start"
                app:icon="@android:drawable/ic_media_play"
                app:iconGravity="textStart"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/settingsLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:gravity="bottom">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="24dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="?attr/colorOutlineVariant">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp">

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/tvSensitivityTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:singleLine="false"
                                android:text="@string/tuner_sensitivity"
                                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toStartOf="@+id/btnTestMic"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                android:layout_marginEnd="12dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnTestMic"
                                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:contentDescription="@string/mic_test"
                                app:tooltipText="@string/mic_test"
                                app:icon="@drawable/ic_mic"
                                app:iconGravity="textStart"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                android:insetLeft="0dp"
                                android:insetRight="0dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp" />

                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/micLevelIndicator"
                            android:max="2000"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:visibility="gone"
                            app:trackColor="?attr/colorOutlineVariant"
                            app:indicatorColor="?attr/colorPrimary"
                            app:trackThickness="8dp"
                            app:trackCornerRadius="4dp" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderSensitivity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="50"
                        android:valueTo="2000" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="24dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="?attr/colorOutlineVariant">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/theme_title"
                            android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/themeToggleGroup"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            app:selectionRequired="true"
                            app:singleSelection="true">
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnLightTheme"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/theme_light" />
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnSystemTheme"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/theme_system" />
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnDarkTheme"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/theme_dark" />
                        </com.google.android.material.button.MaterialButtonToggleGroup>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchDynamicColor"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="@string/system_palette"
                            android:textAppearance="@style/TextAppearance.Material3.LabelLarge" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAbout"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginBottom="8dp"
                    android:text="@string/about_title"
                    app:icon="@drawable/ic_info" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/bottom_nav_menu" />

</androidx.constraintlayout.widget.ConstraintLayout>